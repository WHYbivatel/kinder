OPENAI_API_KEY=your-openai-api-key-here
# Нужен положительный баланс на https://platform.openai.com/settings/organization/billing
OPENAI_MODEL=gpt-4o-mini
TMDB_API_KEY=your-tmdb-api-key-here
# Рейтинги IMDb и Кинопоиска берутся с HDRezka (без ключей)
HDREZKA_BASE=https://hdrezka.name
# Необязательный запасной источник, если HDRezka недоступна:
# OMDB_API_KEY=your-omdb-api-key-here
# KINOPOISK_API_KEY=your-kinopoisk-api-key-here
